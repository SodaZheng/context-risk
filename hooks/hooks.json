{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" auto-repair",
            "timeout": 5,
            "statusMessage": "ContextRisk repairing status line"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "ContextRisk checking auto handoff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook PreToolUse",
            "timeout": 5,
            "statusMessage": "ContextRisk checking auto handoff"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook PostToolBatch",
            "timeout": 10,
            "statusMessage": "ContextRisk checking auto handoff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook Stop",
            "timeout": 5,
            "statusMessage": "ContextRisk checking auto handoff"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook SubagentStop",
            "timeout": 5,
            "statusMessage": "ContextRisk checking auto handoff"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook PreCompact",
            "timeout": 5,
            "statusMessage": "ContextRisk checking auto handoff"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook PostCompact",
            "timeout": 5,
            "statusMessage": "ContextRisk checking auto handoff"
          }
        ]
      }
    ]
  }
}
